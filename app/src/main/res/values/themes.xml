<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CustomView" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item tools:targetApi="l" name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Base.Theme.ReuseExample"
        parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Добавили определение атрибута стиля для светлой темы -->
        <item name="buttonContainerStyle">@style/DayButtonsContainerStyle</item>
    </style>

    <style name="Theme.ReuseExample"
        parent="Base.Theme.ReuseExample" />
</resources>